{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel|escape }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title|escape }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text|escape }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning|escape }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success|escape }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}

    <ul class="nav nav-tabs">
      <li class="active"><a href="{{ products_url }}"><i class="fa fa-cubes"></i> {{ text_products_tab }}</a></li>
      <li><a href="{{ categories_url }}"><i class="fa fa-folder-open"></i> {{ text_categories_tab }}</a></li>
      <li><a href="{{ settings_url }}"><i class="fa fa-cog"></i> {{ text_settings_tab }}</a></li>
    </ul>

    <div class="row">
      <div class="col-md-8">
        <div class="panel panel-default">
          <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cloud-download"></i> {{ text_feed }}</h3></div>
          <div class="panel-body">
            <p><a href="{{ feed_url|escape }}" target="_blank" rel="noopener noreferrer">{{ feed_url|escape }}</a></p>
            {% if feed_metadata.exists %}
              <p class="text-success"><i class="fa fa-check-circle"></i>
                {% if feed_metadata.modified_at %}{{ text_feed_cached|format(feed_metadata.modified_at) }}{% else %}{{ text_feed }}{% endif %}
                {% if feed_metadata.count is defined %} &middot; {{ text_feed_items|format(feed_metadata.count) }}{% endif %}
              </p>
            {% else %}
              <p class="text-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_feed_not_loaded }}</p>
            {% endif %}
            <p class="help-block">{{ text_refresh_help }}</p>
          </div>
          <div class="panel-footer">
            <form action="{{ refresh_url }}" method="post" id="activeshop-refresh-form" class="form-inline">
              <input type="hidden" name="csrf_token" value="{{ csrf_token|escape }}" />
              <button type="button" id="button-activeshop-refresh" class="btn btn-info"><i class="fa fa-refresh"></i> {{ button_refresh }}</button>
            </form>
            <div id="activeshop-refresh-progress" class="alert alert-info" role="status" aria-live="polite" style="display:none;margin:10px 0 0">
              <i class="fa fa-circle-o-notch fa-spin"></i> {{ text_refresh_working|escape }}
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="panel panel-default">
          <div class="panel-heading clearfix">
            <h3 class="panel-title pull-left"><i class="fa fa-bar-chart"></i> {{ column_status }}</h3>
            {% if filters.filter_status == 'new' %}
              <a href="{{ all_statuses_url }}" class="btn btn-default btn-xs pull-right"><i class="fa fa-times"></i> {{ button_all_statuses }}</a>
            {% else %}
              <a href="{{ new_products_url }}" class="btn btn-info btn-xs pull-right"><i class="fa fa-filter"></i> {{ button_only_new }} ({{ status_counts.new|default(0) }})</a>
            {% endif %}
          </div>
          <div class="panel-body">
            <a href="{{ new_products_url }}" class="label label-info">{{ text_status_new }}: {{ status_counts.new|default(0) }}</a>
            <span class="label label-warning">{{ text_status_existing }}: {{ status_counts.existing|default(0) }}</span>
            <span class="label label-success">{{ text_status_imported }}: {{ status_counts.imported|default(0) }}</span>
            <span class="label label-danger">{{ text_status_conflict }}: {{ status_counts.conflict|default(0) }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3></div>
      <div class="panel-body">
        <form action="index.php" method="get" class="form-horizontal" id="activeshop-filter-form">
          <input type="hidden" name="route" value="extension/module/activeshop_importer" />
          <input type="hidden" name="user_token" value="{{ user_token|escape }}" />
          <div class="row">
            <div class="col-md-3">
              <label for="input-filter-search">{{ entry_search }}</label>
              <input type="text" name="filter_search" value="{{ filters.filter_search|escape }}" id="input-filter-search" class="form-control" />
            </div>
            <div class="col-md-2">
              <label for="input-filter-status">{{ entry_status }}</label>
              <select name="filter_status" id="input-filter-status" class="form-control">
                <option value="all"{% if filters.filter_status == '' %} selected{% endif %}>{{ text_all }}</option>
                {% for key in ['new', 'existing', 'imported', 'conflict'] %}
                  <option value="{{ key|escape }}"{% if filters.filter_status == key %} selected{% endif %}>{{ attribute(_context, 'text_status_' ~ key)|escape }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4">
              <label for="input-filter-category">{{ entry_supplier_category }}</label>
              <select name="filter_category" id="input-filter-category" class="form-control">
                <option value="">{{ text_all }}</option>
                {% for category in supplier_categories %}
                  <option value="{{ category.category_path|escape }}"{% if filters.filter_category == category.category_path %} selected{% endif %}>{{ category.category_path|escape }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2">
              <label for="input-filter-brand">{{ entry_brand }}</label>
              <input type="text" name="filter_brand" value="{{ filters.filter_brand|escape }}" id="input-filter-brand" class="form-control" />
            </div>
            <div class="col-md-1">
              <label>&nbsp;</label>
              <button type="button" id="button-activeshop-filter" class="btn btn-primary btn-block" title="{{ button_filter }}"><i class="fa fa-search"></i></button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <form action="{{ import_url }}" method="post" id="activeshop-import-form">
      <input type="hidden" name="csrf_token" value="{{ csrf_token|escape }}" />

      <div class="panel panel-primary">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-download"></i> {{ text_import }}</h3></div>
        <div class="panel-body">
          <div class="row">
            <div class="col-md-3">
              <label for="input-markup">{{ entry_markup }}</label>
              <div class="input-group">
                <input type="text" name="markup" value="{{ settings.markup|escape }}" id="input-markup" class="form-control" inputmode="decimal" />
                <span class="input-group-addon">%</span>
              </div>
            </div>
            <div class="col-md-4">
              <label for="input-existing-action">{{ entry_existing_action }}</label>
              <select name="existing_action" id="input-existing-action" class="form-control">
                <option value="skip"{% if settings.existing_action == 'skip' %} selected{% endif %}>{{ text_existing_skip }}</option>
                <option value="price_quantity"{% if settings.existing_action == 'price_quantity' %} selected{% endif %}>{{ text_existing_price_quantity }}</option>
              </select>
            </div>
            <div class="col-md-3">
              <label>{{ text_default_category }}</label>
              <p class="form-control-static">ID {{ settings.default_category_id ?: text_not_available }} &middot; <a href="{{ settings_url }}">{{ text_settings_tab }}</a></p>
            </div>
            <div class="col-md-2 text-right">
              <label>&nbsp;</label>
              <button type="button" id="button-activeshop-import" class="btn btn-success btn-block"><i class="fa fa-download"></i> {{ button_import }}</button>
            </div>
          </div>
          <p class="help-block">{{ text_formula_help }} {{ text_import_help }}</p>
          <div id="activeshop-import-progress" class="alert alert-info" role="status" aria-live="polite" style="display:none;margin-bottom:0">
            <div class="progress" style="margin-bottom:8px">
              <div class="progress-bar progress-bar-striped active js-import-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width:0%">0%</div>
            </div>
            <span class="js-import-progress-text"></span>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-hover table-striped">
            <thead>
              <tr>
                <td class="text-center" style="width:35px"><input type="checkbox" class="js-select-all" /></td>
                <td class="text-center">{{ column_image }}</td>
                <td>{{ column_sku }}</td>
                <td>{{ column_name }}</td>
                <td>{{ column_supplier_category }}</td>
                <td class="text-center">{{ column_status }}</td>
                <td class="text-right">{{ column_quantity }}</td>
                <td class="text-right">{{ column_price }}</td>
                <td class="text-right">{{ column_action }}</td>
              </tr>
            </thead>
            <tbody>
              {% if products %}
                {% for product in products %}
                  <tr>
	                    <td class="text-center"><input type="checkbox" name="selected[]" value="{{ product.supplier_product_id|escape }}" data-status="{{ product.status_key|escape }}" class="js-product-checkbox"{% if not product.can_import %} disabled{% endif %} /></td>
                    <td class="text-center">
                      {% if product.preview_image %}<img src="{{ product.preview_image|escape }}" alt="" class="img-thumbnail" style="max-width:55px;max-height:55px" loading="lazy" referrerpolicy="no-referrer" />{% else %}<i class="fa fa-picture-o text-muted"></i>{% endif %}
                    </td>
                    <td><strong>{{ product.sku|escape }}</strong>{% if product.ean %}<br><small class="text-muted">EAN {{ product.ean|escape }}</small>{% endif %}</td>
                    <td>
                      {{ product.name|escape }}
                      {% if product.brand %}<br><small class="text-muted">{{ product.brand|escape }}</small>{% endif %}
                      {% if product.has_special %}<br><span class="label label-danger" title="{{ text_special_warning }}"><i class="fa fa-tag"></i> Special</span>{% endif %}
                      {% if product.match_message %}<br><small class="text-danger">{{ product.match_message|escape }}</small>{% endif %}
                    </td>
                    <td>
                      <small>{{ product.category_path|escape }}</small>
                      {% if product.mapped_category_id %}
                        <br><span class="label label-success" title="{{ text_mapped_category|escape }}"><i class="fa fa-folder-open"></i> {{ text_mapped_category|escape }}: {% if product.mapped_category_name %}{{ product.mapped_category_name|escape }}{% else %}ID {{ product.mapped_category_id }}{% endif %}</span>
                      {% endif %}
                    </td>
                    <td class="text-center"><span class="label label-{{ product.status_class|escape }}">{{ product.status_text|escape }}</span></td>
                    <td class="text-right">{{ product.quantity }}</td>
                    <td class="text-right text-nowrap">
                      <small>{{ text_feed_price }}:</small> {{ product.feed_price|number_format(2, ',', '.') }} €<br>
                      <strong>{{ text_new_price }} ({{ text_net }}): <span class="js-calculated-price" data-feed-price="{{ product.feed_price|escape }}">{{ product.calculated_price|number_format(2, ',', '.') }}</span> €</strong><br>
                      {% if product.product_id %}<small>{{ text_current_price }}: {{ product.local_price|number_format(2, ',', '.') }} €</small>{% endif %}
                    </td>
                    <td class="text-right">{% if product.edit %}<a href="{{ product.edit }}" class="btn btn-primary btn-sm" data-toggle="tooltip" title="{{ button_edit|escape }}"><i class="fa fa-pencil"></i></a>{% endif %}</td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr><td colspan="9" class="text-center">{% if feed_metadata.exists %}{{ text_no_results }}{% else %}{{ text_feed_not_loaded }}{% endif %}</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="panel-footer clearfix">
          <div class="pull-left">{{ results }}</div>
          <div class="pull-right">{{ pagination }}</div>
        </div>
      </div>
    </form>

    {% if recent_runs %}
      <div class="panel panel-default" style="margin-bottom:40px">
        <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-history"></i> {{ text_recent_runs|escape }}</h3></div>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead><tr><td>{{ column_date|escape }}</td><td>{{ column_action|escape }}</td><td>{{ entry_markup|escape }}</td><td>{{ column_result|escape }}</td></tr></thead>
            <tbody>
              {% for run in recent_runs %}
                {% set counts = run.counts_data|default({}) %}
                <tr>
                  <td class="text-nowrap">{{ run.date_started|escape }}</td>
                  <td>{% if run.type == 'refresh' %}{{ text_run_refresh|escape }}{% else %}{{ text_run_import|escape }}{% endif %}</td>
                  <td class="text-right">{{ run.markup|number_format(2, ',', '.') }}%</td>
                  <td>
                    <strong>{{ run.status|escape }}</strong><br>
                    <small>{{ text_run_counts|format(counts.selected|default(0), counts.created|default(0), counts.updated|default(0), counts.skipped|default(0), counts.failed|default(0))|escape }}</small>
                    {% if run.type == 'refresh' %}<br><small>{{ text_run_refresh_counts|format(counts.staged|default(counts.selected|default(0)), counts.importable|default(0), counts.excluded_invalid|default(counts.skipped_invalid|default(0)))|escape }}</small>{% endif %}
                    {% if run.error %}<br><small class="text-danger">{{ run.error|escape }}</small>{% endif %}
                    {% if run.error_items %}
                      <br><small class="text-danger">{{ text_run_error_items|escape }}</small>
                      <ul class="list-unstyled">
                        {% for item in run.error_items %}<li><small><strong>{{ item.external_id|escape }}</strong>: {{ item.message|escape }}</small></li>{% endfor %}
                      </ul>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script type="text/javascript"><!--
(function() {
  var importRunning = false;
  var importUrl = {{ import_url|json_encode|raw }};
  var csrfToken = {{ csrf_token|json_encode|raw }};
  var textImportProcessing = {{ text_import_processing|json_encode|raw }};
  var textImportBusyRetry = {{ text_import_busy_retry|json_encode|raw }};
  var textImportNetworkError = {{ text_import_network_error|json_encode|raw }};
  var textImportSuccess = {{ text_import_success|json_encode|raw }};

  function formatNumbers(template, values) {
    $.each(values, function(index, value) {
      template = template.replace('%d', String(value));
    });
    return template;
  }

  function parseMarkup(value) {
    value = String(value || '').replace(',', '.');
    var number = Number(value);
    return isFinite(number) && number >= 0 ? number : 0;
  }

  function updatePrices() {
    var markup = parseMarkup($('#input-markup').val());
    $('.js-calculated-price').each(function() {
      var feedPrice = Number($(this).data('feed-price')) || 0;
      var value = Math.round((feedPrice * (1 + markup / 100) + Number.EPSILON) * 100) / 100;
      $(this).text(value.toLocaleString('hr-HR', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
    });
  }

  $('#input-markup').on('input change', updatePrices);
  $('#button-activeshop-filter').on('click', function() {
    document.getElementById('activeshop-filter-form').submit();
  });
  $('.js-select-all').on('change', function() {
    $('.js-product-checkbox:not(:disabled)').prop('checked', this.checked);
  });
  $('#button-activeshop-refresh').on('click', function() {
    if (!window.confirm({{ text_refresh_confirm|json_encode|raw }})) {
      return false;
    }

    $('#button-activeshop-refresh').prop('disabled', true);
    $('#activeshop-refresh-progress').show();
    document.getElementById('activeshop-refresh-form').submit();
  });

  function lockImportUi(locked) {
    $('#button-activeshop-import, #button-activeshop-refresh, #button-activeshop-filter, #input-markup, #input-existing-action, .js-select-all, .js-product-checkbox').prop('disabled', locked);
  }

  function updateImportProgress(processed, total, message) {
    var percent = total ? Math.round((processed / total) * 100) : 0;
    var $bar = $('#activeshop-import-progress .js-import-progress-bar');
    $bar.css('width', percent + '%').attr('aria-valuenow', percent).text(percent + '%');
    $('#activeshop-import-progress .js-import-progress-text').text(message);
  }

  function finishSequentialImport(totals, total, lastError) {
    importRunning = false;
    $(window).off('beforeunload.activeshopImport');

    var summary = formatNumbers(textImportSuccess, [totals.created, totals.updated, totals.skipped, totals.failed]);
    var $progress = $('#activeshop-import-progress');
    var $bar = $progress.find('.js-import-progress-bar');
    updateImportProgress(total, total, summary);
    $bar.removeClass('active progress-bar-info progress-bar-success progress-bar-danger')
      .addClass(totals.failed ? 'progress-bar-danger' : 'progress-bar-success');
    $progress.removeClass('alert-info alert-success alert-warning')
      .addClass(totals.failed ? 'alert-warning' : 'alert-success');

    if (lastError) {
      $progress.find('.js-import-progress-text').text(summary + ' ' + lastError);
    }

    window.alert(summary + (lastError ? '\n' + lastError : ''));
    window.location.reload();
  }

  function stopSequentialImport(processed, total, message) {
    importRunning = false;
    $(window).off('beforeunload.activeshopImport');

    var $progress = $('#activeshop-import-progress');
    var $bar = $progress.find('.js-import-progress-bar');
    updateImportProgress(processed, total, message);
    $bar.removeClass('active progress-bar-info progress-bar-success').addClass('progress-bar-danger');
    $progress.removeClass('alert-info alert-success').addClass('alert-warning');

    window.alert(message);
    window.location.reload();
  }

  function runSequentialImport(ids, index, totals, settings, busyAttempt, lastError) {
    if (index >= ids.length) {
      finishSequentialImport(totals, ids.length, lastError);
      return;
    }

    updateImportProgress(index, ids.length, formatNumbers(textImportProcessing, [index + 1, ids.length]));

    $.ajax({
      url: importUrl,
      type: 'post',
      dataType: 'json',
      timeout: 0,
      data: {
        ajax: '1',
        csrf_token: csrfToken,
        markup: settings.markup,
        existing_action: settings.existingAction,
        'selected[]': ids[index]
      }
    }).done(function(response) {
      if (response && response.retryable && response.error_code === 'busy') {
        if (busyAttempt >= 100) {
          stopSequentialImport(index, ids.length, response.error || textImportNetworkError);
          return;
        }

        updateImportProgress(index, ids.length, formatNumbers(textImportBusyRetry, [index + 1, ids.length]));
        window.setTimeout(function() {
          runSequentialImport(ids, index, totals, settings, busyAttempt + 1, lastError);
        }, 3000);
        return;
      }

      if (!response || !response.counts) {
        stopSequentialImport(index, ids.length, response && response.error ? String(response.error) : textImportNetworkError);
        return;
      }

      totals.created += Number(response.counts.created) || 0;
      totals.updated += Number(response.counts.updated) || 0;
      totals.skipped += Number(response.counts.skipped) || 0;
      totals.failed += Number(response.counts.failed) || 0;

      if (!response || response.success !== true || response.item_success === false) {
        lastError = response && response.error ? String(response.error) : textImportNetworkError;
      }

      updateImportProgress(index + 1, ids.length, formatNumbers(textImportProcessing, [index + 1, ids.length]));
      window.setTimeout(function() {
        runSequentialImport(ids, index + 1, totals, settings, 0, lastError);
      }, 150);
    }).fail(function() {
      // The server may have completed the item after the connection was lost.
      // Do not retry an ambiguous request because that could duplicate work.
      stopSequentialImport(index, ids.length, textImportNetworkError);
    });
  }

  $('#activeshop-import-form').on('submit', function(event) {
    event.preventDefault();
    $('#button-activeshop-import').trigger('click');
  });

  $('#button-activeshop-import').on('click', function() {
    if (importRunning) {
      return false;
    }

    var ids = $('.js-product-checkbox:checked').map(function() {
      return this.value;
    }).get();
    var count = ids.length;
    if (!count) {
      alert({{ error_selected|json_encode|raw }});
      return false;
    }

    var message = {{ text_import_confirm|json_encode|raw }}.replace('%s', count).replace('%s', $('#input-markup').val());
    if (!window.confirm(message)) {
      return false;
    }

    importRunning = true;
    var settings = {
      markup: $('#input-markup').val(),
      existingAction: $('#input-existing-action').val()
    };
    lockImportUi(true);
    $('#activeshop-import-progress').show();
    updateImportProgress(0, count, formatNumbers(textImportProcessing, [1, count]));
    $(window).on('beforeunload.activeshopImport', function() {
      return textImportProcessing;
    });
    runSequentialImport(ids, 0, {created: 0, updated: 0, skipped: 0, failed: 0}, settings, 0, '');
    return false;
  });
})();
//--></script>
{{ footer }}
