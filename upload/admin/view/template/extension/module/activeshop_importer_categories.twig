{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel|escape }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_categories|escape }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text|escape }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning|escape }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success|escape }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    <ul class="nav nav-tabs">
      <li><a href="{{ products_url }}"><i class="fa fa-cubes"></i> {{ text_products_tab }}</a></li>
      <li class="active"><a href="{{ categories_url }}"><i class="fa fa-folder-open"></i> {{ text_categories_tab }}</a></li>
      <li><a href="{{ settings_url }}"><i class="fa fa-cog"></i> {{ text_settings_tab }}</a></li>
    </ul>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-search"></i> {{ text_filter }}</h3></div>
      <div class="panel-body">
        <form action="index.php" method="get" class="form-inline">
          <input type="hidden" name="route" value="extension/module/activeshop_importer/categories" />
          <input type="hidden" name="user_token" value="{{ user_token|escape }}" />
          <div class="form-group"><input type="text" name="filter_search" value="{{ filter_search|escape }}" placeholder="{{ entry_supplier_category|escape }}" class="form-control" size="60" /></div>
          <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> {{ button_filter }}</button>
          <a href="{{ categories_url }}" class="btn btn-default"><i class="fa fa-times"></i> {{ button_clear }}</a>
        </form>
      </div>
    </div>

    <form action="{{ save_url }}" method="post" id="form-category-map">
      <input type="hidden" name="csrf_token" value="{{ csrf_token|escape }}" />
      <div class="panel panel-default">
        <div class="panel-heading clearfix">
          <h3 class="panel-title pull-left"><i class="fa fa-exchange"></i> {{ heading_categories }}</h3>
          <button type="submit" class="btn btn-primary pull-right"><i class="fa fa-save"></i> {{ button_save }}</button>
        </div>
        <div class="panel-body"><p class="help-block">{{ text_category_fallback_help }}</p></div>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead><tr><td>{{ column_supplier_category }}</td><td class="text-right">{{ column_products }}</td><td>{{ column_local_category }}</td></tr></thead>
            <tbody>
              {% if categories %}
                {% for category in categories %}
                  <tr>
                    <td>
                      {{ category.category_path|escape }}
                      <input type="hidden" name="mapping[{{ loop.index0 }}][path]" value="{{ category.category_path|escape }}" />
                    </td>
                    <td class="text-right">{{ category.product_count|default(0) }}</td>
                    <td>
                      <div class="input-group">
                        <input type="text" value="{{ category.local_category_name|escape }}" class="form-control js-category-autocomplete" autocomplete="off" />
                        <input type="hidden" name="mapping[{{ loop.index0 }}][category_id]" value="{{ category.category_id|escape }}" class="js-category-id" />
                        <span class="input-group-btn"><button type="button" class="btn btn-default js-clear-category"><i class="fa fa-times"></i></button></span>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr><td colspan="3" class="text-center">{{ text_no_results }}</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="panel-footer clearfix"><div class="pull-left">{{ results }}</div><div class="pull-right">{{ pagination }}</div></div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('.js-category-autocomplete').each(function() {
  var input = $(this);
  input.on('input', function() {
    input.siblings('.js-category-id').val('0');
  });
  input.autocomplete({
    source: function(request, response) {
      $.ajax({
        url: {{ category_autocomplete_url|json_encode|raw }} + encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          response($.map(json, function(item) { return {label: item.name, value: item.category_id}; }));
        }
      });
    },
    select: function(item) {
      input.val(item.label);
      input.siblings('.js-category-id').val(item.value);
    }
  });
});
$('.js-clear-category').on('click', function() {
  var group = $(this).closest('.input-group');
  group.find('.js-category-autocomplete').val('');
  group.find('.js-category-id').val('0');
});
//--></script>
{{ footer }}
