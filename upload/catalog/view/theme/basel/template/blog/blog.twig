{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}



    {% set class = 'col-sm-12' %}
    
    <div id="content" class="{{ class }} wob-blog-content">{{ content_top }}
    <article class="blog blog_post wob-blog-post">
    
    {% if main_thumb and blogsetting_post_thumb %}
    <div class="main_thumb wob-blog-hero">
    <img src="{{ main_thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" />
    {% if post_date_added_status %}
    <div class="date_added">
    <span class="day">{{ date_added_day }}</span>
    <b class="month">{{ date_added_month }}</b>
    </div>
    {% endif %}
    </div>
    {% endif %}
    
	<h1 id="page-title" class="contrast-font">{{ heading_title }}</h1>
	
    <div class="blog_stats">
	{% if post_author_status %}<i>{{ text_posted_by }}: {{ author }}</i>{% endif %}
	{% if post_page_view_status %}<i>{{ text_read }}: {{ new_read_counter_value }}</i>{% endif %}
	{% if post_comments_count_status %}<i>{{ text_comments }}: {{ comment_total }}</i>{% endif %}
	</div>
    
    <div class="main_description wob-blog-article-copy">
	{{ description }}
    </div>
    
    {% if tags %}
	<p class="post_tags wob-blog-tags">
    {{ text_tags }}
	{% for i in 0..tags|length %}
    {% if i < (tags|length - 1) %} 
    <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a>,
    {% else %} 
    <a href="{{ tags[i].href }}">{{ tags[i].tag }}</a> {% endif %}
    {% endfor %}
	</p>
	{% endif %}

	{% set blog_share_url = share|replace({'&amp;': '&'}) %}
    <nav class="wob-blog-share" aria-label="Podijeli članak">
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ blog_share_url|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Podijeli na Facebooku"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
      <a href="https://x.com/intent/post?url={{ blog_share_url|url_encode }}&amp;text={{ heading_title|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Podijeli na X-u"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
      <a href="https://wa.me/?text={{ (heading_title ~ ' ' ~ blog_share_url)|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Podijeli na WhatsAppu"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
      <a href="mailto:?subject={{ heading_title|url_encode }}&amp;body={{ blog_share_url|url_encode }}" aria-label="Podijeli e-mailom"><i class="fa-light fa-envelope" aria-hidden="true"></i></a>
    </nav>
	
    <!-- Related Products -->
    {% if products %}
      <h3 class="section-title"><b>{{ text_related_products }}</b></h3>
        <div class="grid-holder grid grid{{ rel_prod_per_row }}">
        {% for product in products %}
        {% include 'basel/template/product/single_product.twig' %}
        {% endfor %}
      </div>
      {% endif %}
	 <!-- Related Products End -->
     
     
     {% if related_blogs %}
		<h3 class="section-title"><b>{{ text_related_blog }}</b></h3>
        <div class="grid-holder grid{{ rel_per_row }} wob-blog-grid wob-blog-related">
            {% for blog in related_blogs %}
            <article class="item single-blog related wob-blog-card">
                {% if blog.image and rel_thumb_status %}
                <div class="banner_wrap hover-zoom hover-darken wob-blog-media">
				<img class="zoom_image" src="{{ blog.image }}" alt="{{ blog.title }}" title="{{ blog.title }}" loading="lazy" />
                <a href="{{ blog.href }}" class="effect-holder"></a>
                {% if date_added_status %}
                <div class="date_added">
                <span class="day">{{ blog.date_added_full|date('d') }}</span>
                <b class="month">{{ blog.date_added_full|date('M') }}</b>
                </div>
                {% endif %}
                {% if blog.tags %}
                <div class="tags-wrapper">
                <div class="tags primary-bg-color">
                {% for tag in blog.tags|slice(0,2) %}
                <a href="index.php?route=extension/blog/home&tag={{ tag|trim }}">{{ tag|trim }}</a>
                {% endfor %}
                </div>
                </div>
                {% endif %}
                </div>
				{% endif %}
                <div class="summary wob-blog-summary">
                <h3 class="blog-title"><a href="{{ blog.href }}">{{ blog.title }}</a></h3>
                <div class="blog_stats">
                {% if author_status %}<i>{{ text_posted_by }}: {{ blog.author }}</i>{% endif %}
				{% if comments_count_status %}<i>{{ text_comments }}: {{ blog.comment_total }}</i>{% endif %}
                {% if page_view_status %}<i>{{ text_read }}: {{ blog.count_read }}</i>{% endif %}
                </div>
				<p class="short-description">{{ blog.short_description }}</p>
                <a class="wob-blog-read-more" href="{{ blog.href }}">{{ text_read_more }}</a>
                </div>
               </article>
			{% endfor %}           
		</div>
	{% endif %}
	 <!-- Related Blog End -->
	 

      </article>
     
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script><!--
$('#comment').delegate('.pagination a', 'click', function(e) {
  e.preventDefault();
	$("html,body").animate({scrollTop:(($("#comment").offset().top)-50)},500);
    $('#comment').fadeOut(50);

    $('#comment').load(this.href);

    $('#comment').fadeIn(500);
	
});

$('#comment').load('index.php?route=extension/blog/blog/comment&blog_id={{ blog_id }}');
//--></script>

<script><!--

$('#button-comment').on('click', function() {
	$.ajax({
		url: 'index.php?route=extension/blog/blog/write&blog_id={{ blog_id }}',
		type: 'post',
		dataType: 'json',
		data: $("#comment_form").serialize(),
		
		complete: function() {
			$('#button-comment').button('reset');
			$('#captcha_comment').attr('src', 'index.php?route=extension/blog/blog/captcha');
			$('input[name=\'captcha_comment\']').val('');
		},
		success: function(json) {
			$('.alert-success, .alert-danger').remove();
			
			if (json.error) {
				$('#write_response').html('<div class="alert alert-sm alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json.error + '</div>');
			}
			
			if (json.success) {
				$('#write_response').html('<div class="alert alert-sm alert-success"><i class="fa fa-check-circle"></i> ' + json.success + '</div>');
				
				$('input[name=\'name\']').val('');
				$('input[name=\'email\']').val('');
				$('textarea[name=\'comment\']').val('');
				$('input[name=\'captcha_comment\']').val('');
			}
		}
	});
});
</script>

<script type="application/ld+json">
{
"@context": "https://schema.org",
"@type": "NewsArticle",
"mainEntityOfPage": {
"@type": "WebPage",
"@id": {{ share|replace({'&amp;': '&'})|json_encode|raw }}
},
"headline": {{ heading_title|json_encode|raw }},
{% if main_thumb %}
"image": {
"@type": "ImageObject",
"url": {{ main_thumb|json_encode|raw }},
"height": {{ img_height }},
"width": {{ img_width }}
},
{% endif %}
"datePublished": {{ date_added_full|json_encode|raw }},
"dateModified": {{ date_added_full|json_encode|raw }},
"author": {
"@type": "Person",
"name": {{ author|json_encode|raw }}
},
"publisher": {
"@type": "Organization",
"name": {{ store|json_encode|raw }}{% if logo %},
{% endif %}
{% if logo %}
"logo": {
"@type": "ImageObject",
"url": {{ logo|json_encode|raw }}
}
{% endif %}
},
"description": {{ short_description|json_encode|raw }}
}
</script>
{{ footer }}
