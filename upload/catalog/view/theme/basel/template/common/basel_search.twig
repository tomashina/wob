<div class="search-field">
<input type="text" name="search" value="{{ search }}" placeholder="{{ basel_text_search }}" aria-label="{{ basel_text_search }}" class="form-control main-search-input" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" />
<button type="button" class="btn btn-contrast do-search main" aria-label="{{ basel_text_search }}"><i class="fa fa-search" aria-hidden="true"></i></button>
</div>
<script>
$(document).ready(function() {
$('.search-holder-mobile input[name=\'search-mobile\']').attr("placeholder", "{{ basel_text_search }}").attr("value", "{{ search }}");
});
</script>
